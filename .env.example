# Liquidation Guardian does not read a private key.
# Do not add PRIVATE_KEY, a mnemonic, or a trading-key secret.

# Optional app host settings. Leave unset for a local read-only preview.
# DATABASE_URL=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
# VITE_AUTH_ENABLED=false

# Optional Grok preview sign-in. Not used by the Hideki monitor.
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=
# GROK_PROJECT_ID=
